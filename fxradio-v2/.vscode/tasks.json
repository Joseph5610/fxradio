{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Desktop: Spustiť Vývoj (Dev)",
      "type": "shell",
      "command": "npm run tauri dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": ["relative", "${workspaceFolder}/fxradio-v2"],
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*VITE v.*ready in.*",
          "endsPattern": "^\\s*➜\\s*Local:.*"
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/fxradio-v2"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Desktop: Build Inštalátora (Production)",
      "type": "shell",
      "command": "npm run tauri build",
      "options": {
        "cwd": "${workspaceFolder}/fxradio-v2"
      }
    },
    {
      "label": "Web: Spustiť Vývoj (Dev)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": ["relative", "${workspaceFolder}/fxradio-v2"],
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*VITE v.*ready in.*",
          "endsPattern": "^\\s*➜\\s*Local:.*"
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/fxradio-v2"
      }
    },
    {
      "label": "Web: Build Production (HTML/JS)",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/fxradio-v2"
      }
    }
  ]
}
